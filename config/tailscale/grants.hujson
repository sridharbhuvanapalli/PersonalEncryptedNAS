{
  // Replace example.invalid identities before applying this policy.
  "tagOwners": {"tag:nas": ["group:nas-admins"]},
  "groups": {
    "group:nas-admins": ["admin@example.invalid"],
    "group:family": ["family@example.invalid"]
  },
  "grants": [
    {"src": ["group:family"], "dst": ["tag:nas"], "ip": ["tcp:443", "tcp:53", "udp:53"]},
    {"src": ["group:nas-admins"], "dst": ["tag:nas"], "ip": ["tcp:22", "tcp:443", "tcp:53", "udp:53"]}
  ],
  "ssh": [
    {"action": "check", "src": ["group:nas-admins"], "dst": ["tag:nas"], "users": ["autogroup:nonroot"]}
  ]
}
