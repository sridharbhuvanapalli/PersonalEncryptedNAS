#!/bin/sh
set -eu

project=${1:?usage: compose-with-secrets PROJECT_DIR [compose arguments...]}
shift

case "$project" in
  compose/immich)
    : "${IMMICH_DB_PASSWORD_FILE:?set IMMICH_DB_PASSWORD_FILE}"
    [ -f "$IMMICH_DB_PASSWORD_FILE" ] || { echo "secret file not found" >&2; exit 2; }
    if stat -c '%a' "$IMMICH_DB_PASSWORD_FILE" >/dev/null 2>&1; then
      secret_mode=$(stat -c '%a' "$IMMICH_DB_PASSWORD_FILE")
    else
      secret_mode=$(stat -f '%Lp' "$IMMICH_DB_PASSWORD_FILE")
    fi
    [ "$secret_mode" = 600 ] || {
      echo "secret file must have mode 600" >&2
      exit 2
    }
    IMMICH_DB_PASSWORD=$(tr -d '\r\n' < "$IMMICH_DB_PASSWORD_FILE")
    export IMMICH_DB_PASSWORD
    ;;
  compose/proxy)
    : "${PNAS_SERVICE_LAN_BIND_IP:?set from the approved deployment.env}"
    : "${PNAS_TAILSCALE_BIND_IP:?set from the approved deployment.env}"
    : "${CADDYFILE_PATH:?set CADDYFILE_PATH from the approved deployment.env}"
    : "${PNAS_DNS_PROVIDER:?set PNAS_DNS_PROVIDER from the approved deployment.env}"
    [ -f "$CADDYFILE_PATH" ] || { echo "generated Caddyfile not found" >&2; exit 2; }
    case "$PNAS_DNS_PROVIDER" in
      cloudflare|rfc2136)
        : "${DNS_PROVIDER_CREDENTIAL_FILE:?set DNS_PROVIDER_CREDENTIAL_FILE}"
        [ -f "$DNS_PROVIDER_CREDENTIAL_FILE" ] || {
          echo "DNS credential file not found" >&2
          exit 2
        }
        if stat -c '%a' "$DNS_PROVIDER_CREDENTIAL_FILE" >/dev/null 2>&1; then
          secret_mode=$(stat -c '%a' "$DNS_PROVIDER_CREDENTIAL_FILE")
        else
          secret_mode=$(stat -f '%Lp' "$DNS_PROVIDER_CREDENTIAL_FILE")
        fi
        [ "$secret_mode" = 600 ] || {
          echo "DNS credential file must have mode 600" >&2
          exit 2
        }
        ;;
      manual)
        DNS_PROVIDER_CREDENTIAL_FILE=/dev/null
        export DNS_PROVIDER_CREDENTIAL_FILE
        ;;
      *)
        echo "unsupported DNS provider" >&2
        exit 2
        ;;
    esac
    ;;
  compose/dns)
    : "${PNAS_SERVICE_LAN_BIND_IP:?set from the approved deployment.env}"
    : "${PNAS_TAILSCALE_BIND_IP:?set from the approved deployment.env}"
    for generated_file in \
      "${COREDNS_LAN_COREFILE:?set from the approved deployment.env}" \
      "${COREDNS_TAILSCALE_COREFILE:?set from the approved deployment.env}" \
      "${COREDNS_LAN_ZONE:?set from the approved deployment.env}" \
      "${COREDNS_TAILSCALE_ZONE:?set from the approved deployment.env}"
    do
      [ -f "$generated_file" ] || { echo "generated DNS file not found" >&2; exit 2; }
    done
    ;;
esac

exec docker compose --project-directory "$project" -f "$project/compose.yaml" "$@"
